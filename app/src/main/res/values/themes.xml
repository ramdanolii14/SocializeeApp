<!--
    res/values/themes.xml
    ─────────────────────────────────────────────────────────────────────────
    Menggunakan Theme.Material3.DayNight.NoActionBar sebagai base.
    Dynamic Color (Material You) diaktifkan lewat SocializeeApp.kt dengan
    DynamicColors.applyToActivitiesIfAvailable(this).

    Pada Android 12+ → warna dari wallpaper user
    Pada Android <12 → fallback ke colorPrimary / colorSecondary di bawah
-->
<resources>

    <!-- ── Base app theme ─────────────────────────────────────────────────── -->
    <style name="Theme.Socializee" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Seed colors (fallback untuk Android < 12) -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_variant</item>
        <item name="colorOnPrimaryContainer">@color/on_primary</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Surface / Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Status bar & nav bar ikut surface -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <!-- Light status bar icons saat light mode (dibalik di night) -->
        <item name="android:windowLightStatusBar">true</item>

        <!-- Global button style -->
        <item name="materialButtonStyle">@style/AppButtonStyle</item>

        <!-- PopupMenu agar teks tidak invisible di dark mode -->
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
        <item name="android:popupMenuStyle">@style/AppPopupMenu</item>

        <!-- TextInputLayout global stroke -->
        <item name="boxStrokeColor">@color/input_stroke_color</item>
    </style>

    <!-- ── Night override: status bar icons gelap di dark mode ─────────────── -->
    <!-- Ditangani otomatis oleh DayNight; windowLightStatusBar = false di malam -->

    <!-- ── Button style ──────────────────────────────────────────────────── -->
    <style name="AppButtonStyle" parent="Widget.Material3.Button">
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ── Outlined button ───────────────────────────────────────────────── -->
    <style name="Widget.MaterialComponents.Button.OutlinedButton"
        parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/divider</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ── Popup menu (fixes invisible text in dark mode) ─────────────────── -->
    <style name="AppPopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:background">@color/surface</item>
    </style>

    <!-- ── Chip style for sort options ───────────────────────────────────── -->
    <style name="SortChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ── Splash / Launch screen ─────────────────────────────────────────── -->
    <style name="Theme.Socializee.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/Theme.Socializee</item>
    </style>

</resources>